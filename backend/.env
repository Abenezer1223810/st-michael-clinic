# St. Michael Medium Clinic - Backend environment
# Copy to .env and adjust as needed.

PORT=5000
# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
# Demo only - do NOT reuse in production
DEMO_TOKEN_SECRET=st-michael-demo-secret-2026

# PostgreSQL Database Connection URL
# Local PostgreSQL default: postgresql://postgres:postgres@localhost:5432/hms_db
# Or Cloud PostgreSQL (Supabase / Neon): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hms_db"
