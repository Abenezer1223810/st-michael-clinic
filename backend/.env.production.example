# ========================================================
# St. Michael Medium Clinic HMS - Production Environment Variables
# ========================================================

NODE_ENV=production
PORT=5000

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://stm_admin:StMichaelSecure2026!@localhost:5432/st_michael_hms?schema=public&connection_limit=20"

# JWT Secret Key (Generate a minimum 64-character high-entropy random string for production)
JWT_SECRET="stm_prod_jwt_super_secret_high_entropy_key_change_me_before_launch_2026_x99!"

# Allowed CORS Client Origins (Comma-separated for multiple domains)
CLIENT_ORIGIN="http://localhost:80,https://stmichaelclinic.et"

# Laboratory Hardware Bridges & TCP Listener Ports
LIS_CBC_PORT=5100
LIS_CHEMISTRY_PORT=5200
LIS_SERIAL_PORT=5300

# Logging & Monitoring
LOG_LEVEL=info
ENABLE_AUDIT_STREAM=true

