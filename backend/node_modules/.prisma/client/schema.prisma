datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id
  username  String   @unique
  password  String
  name      String
  role      String
  title     String?  @default("")
  banned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Patient {
  id                    String   @id
  fullName              String   @map("full_name")
  gender                String
  dateOfBirth           String?  @map("date_of_birth")
  phone                 String
  address               String?  @default("")
  emergencyContactName  String?  @default("") @map("emergency_contact_name")
  emergencyContactPhone String?  @default("") @map("emergency_contact_phone")
  relationshipToPatient String?  @default("") @map("relationship_to_patient")
  allergies             Json?    @default("[]")
  registrationDate      DateTime @default(now()) @map("registration_date")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  visits        Visit[]
  consultations Consultation[]
  labRequests   LabRequest[]
  procedures    Procedure[]
  prescriptions Prescription[]
  queues        Queue[]

  @@index([fullName])
  @@index([phone])
  @@map("patients")
}

model Visit {
  id          String   @id
  visitNumber String   @map("visit_number")
  patientId   String   @map("patient_id")
  patientName String   @map("patient_name")
  service     String
  reason      String?  @default("")
  date        DateTime @default(now())
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  queues        Queue[]
  consultations Consultation[]
  labRequests   LabRequest[]
  procedures    Procedure[]
  prescriptions Prescription[]

  @@index([patientId])
  @@index([date])
  @@map("visits")
}

model Queue {
  id          String   @id
  queueNumber String   @map("queue_number")
  visitId     String   @map("visit_id")
  visitNumber String   @map("visit_number")
  patientId   String   @map("patient_id")
  patientName String   @map("patient_name")
  service     String
  time        DateTime @default(now())
  date        String
  status      String   @default("waiting")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  visit   Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([patientId])
  @@index([date])
  @@map("queues")
}

model Consultation {
  id                      String   @id
  consultationNumber      String   @map("consultation_number")
  visitId                 String   @map("visit_id")
  visitNumber             String   @map("visit_number")
  patientId               String   @map("patient_id")
  patientName             String   @map("patient_name")
  doctor                  String
  doctorId                String?  @default("U-DOCTOR") @map("doctor_id")
  date                    DateTime @default(now())
  status                  String   @default("in_progress")
  vitals                  Json?    @default("{}")
  chiefComplaint          String?  @default("") @map("chief_complaint")
  medicalHistory          String?  @default("") @map("medical_history")
  clinicalExamination     String?  @default("") @map("clinical_examination")
  diagnosis               String?  @default("")
  treatmentRecommendation String?  @default("") @map("treatment_recommendation")
  doctorNotes             String?  @default("") @map("doctor_notes")
  followUp                String?  @default("") @map("follow_up")
  referral                Json?    @default("null")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  visit   Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([patientId])
  @@index([date])
  @@map("consultations")
}

model LabRequest {
  id               String   @id
  requestNumber    String   @map("request_number")
  visitId          String   @map("visit_id")
  visitNumber      String   @map("visit_number")
  patientId        String   @map("patient_id")
  patientName      String   @map("patient_name")
  requestingDoctor String   @map("requesting_doctor")
  date             DateTime @default(now())
  tests            Json
  status           String   @default("pending")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  visit   Visit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  result  LabResult?

  @@index([visitId])
  @@index([patientId])
  @@index([status])
  @@map("lab_requests")
}

model LabResult {
  id             String    @id
  requestId      String    @unique @map("request_id")
  requestNumber  String    @map("request_number")
  patientId      String    @map("patient_id")
  visitId        String    @map("visit_id")
  status         String    @default("pending")
  date           DateTime  @default(now())
  enteredAt      DateTime? @map("entered_at")
  verifiedAt     DateTime? @map("verified_at")
  enteredBy      String?   @map("entered_by")
  verifiedBy     String?   @map("verified_by")
  results        Json      @default("[]")
  instrumentId   String?   @map("instrument_id")
  instrumentName String?   @map("instrument_name")
  rawPayload     Json?     @map("raw_payload")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  request LabRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([patientId])
  @@index([status])
  @@map("lab_results")
}

model LabDevice {
  id         String    @id
  name       String
  type       String // e.g. hematology_cbc, clinical_chemistry, urinalysis, immunology
  protocol   String    @default("REST_JSON") // e.g. REST_JSON, ASTM_1394, HL7_V2
  ipAddress  String?   @map("ip_address")
  port       Int?
  baudRate   Int?      @map("baud_rate")
  status     String    @default("online")
  lastSyncAt DateTime? @map("last_sync_at")
  mappings   Json?     @default("{}") // maps machine test code to LabTest ID e.g. {"WBC":"LT-02","HGB":"LT-01","PLT":"LT-03","GLU":"LT-04","CREA":"LT-07","ALT":"LT-08","CHOL":"LT-06"}
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("lab_devices")
}

model Procedure {
  id               String   @id
  procedureNumber  String   @map("procedure_number")
  visitId          String   @map("visit_id")
  visitNumber      String   @map("visit_number")
  patientId        String   @map("patient_id")
  patientName      String   @map("patient_name")
  requestingDoctor String   @map("requesting_doctor")
  procedureType    String   @map("procedure_type")
  notes            String?  @default("")
  date             DateTime @default(now())
  status           String   @default("requested")
  recording        Json?    @default("null")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  visit   Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([patientId])
  @@index([status])
  @@map("procedures")
}

model Prescription {
  id                 String   @id
  prescriptionNumber String   @map("prescription_number")
  visitId            String   @map("visit_id")
  visitNumber        String   @map("visit_number")
  patientId          String   @map("patient_id")
  patientName        String   @map("patient_name")
  doctor             String
  date               DateTime @default(now())
  medicines          Json     @default("[]")
  status             String   @default("completed")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  visit   Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([patientId])
  @@map("prescriptions")
}

model LabTest {
  id             String @id
  name           String
  group          String
  unit           String
  referenceRange String @map("reference_range")

  @@map("lab_tests")
}

model Medicine {
  id            String  @id
  name          String
  form          String
  defaultDosage String? @map("default_dosage")
  defaultRoute  String? @map("default_route")

  @@map("medicines")
}

model ProcedureType {
  id   String @id
  name String

  @@map("procedure_types")
}

model Department {
  id   String @id
  name String

  @@map("departments")
}
